generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String
  role             Role              @default(STUDENT)
  targetRole       String?
  currentSkills    String[]
  
  // Student Relations
  roadmaps         Roadmap[]
  interviewResults InterviewResult[]
  progress         StudentProgress?
  feedbacksReceived TeacherFeedback[] @relation("StudentFeedback")

  // Teacher Relations
  feedbacksGiven   TeacherFeedback[] @relation("TeacherFeedback")
}

model StudentProgress {
  id               String   @id @default(uuid())
  userId           String   @unique
  skillsCompleted  String[]
  roadmapProgress  Float    // Percentage (0-100)
  lastUpdated      DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

model Roadmap {
  id             String   @id @default(uuid())
  userId         String
  generatedAt    DateTime @default(now())
  dagNodes       Json
  edges          Json
  user           User     @relation(fields: [userId], references: [id])
}

model InterviewResult {
  id             String   @id @default(uuid())
  userId         String
  role           String
  score          Float
  level          String   // Beginner, Intermediate, Advanced
  feedback       String
  conversation   Json     // Full Q&A log
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model TeacherFeedback {
  id             String   @id @default(uuid())
  teacherId      String
  studentId      String
  comment        String
  suggestion     String
  createdAt      DateTime @default(now())
  
  teacher        User     @relation("TeacherFeedback", fields: [teacherId], references: [id])
  student        User     @relation("StudentFeedback", fields: [studentId], references: [id])
}
